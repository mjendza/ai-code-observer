# Copy this file to .env and edit. `npm start` loads it via --env-file.

# Required: IP or hostname of the GeeKmagic clock.
DEVICE_HOST=192.168.1.50

# Optional: gif80 | photo240. Default: photo240
MODE=photo240

# Optional: seconds between fetch+push cycles. Default: 60
PUSH_INTERVAL_SEC=60

# Optional: seconds before forcing a re-push when values are unchanged.
# Default: 0 means always re-render and push every cycle (countdown text
# changes even when percentages don't, so a fresh JPEG is usually wanted).
FORCE_PUSH_SEC=0
